<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mystBackground">

    <ImageView
        android:id="@+id/playerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cover_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/screen_margin_small"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/screen_margin_small">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/playerCover"
            android:layout_width="@dimen/player_cover"
            android:layout_height="@dimen/player_cover"
            android:background="@drawable/bg_cover_placeholder"
            android:contentDescription="@null"
            android:elevation="16dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.CoverLarge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/playerBack"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/auth_back"
                    android:focusable="true"
                    android:nextFocusDown="@id/playerMore"
                    android:nextFocusRight="@id/playerMore"
                    android:src="@drawable/ic_back"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="@string/player_now_playing"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <Space
                    android:layout_width="56dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:letterSpacing="-0.02"
                    android:maxLines="2"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="34sp" />

                <ImageButton
                    android:id="@+id/playerMore"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/player_more"
                    android:focusable="true"
                    android:nextFocusDown="@id/playerArtist"
                    android:nextFocusLeft="@id/playerBack"
                    android:src="@drawable/ic_more"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/playerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_player_focus_text"
                android:ellipsize="end"
                android:maxLines="1"
                android:nextFocusDown="@id/playerSeek"
                android:nextFocusUp="@id/playerMore"
                android:padding="@dimen/space_s"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textColor="#CCFFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/playerAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_player_focus_text"
                android:ellipsize="end"
                android:maxLines="1"
                android:nextFocusDown="@id/playerSeek"
                android:nextFocusUp="@id/playerArtist"
                android:padding="@dimen/space_xs"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textColor="#99FFFFFF"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/playerSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_player_focus_text"
                android:focusable="true"
                android:max="1000"
                android:maxHeight="@dimen/player_progress_height"
                android:minHeight="40dp"
                android:nextFocusDown="@id/playerPlay"
                android:nextFocusUp="@id/playerArtist"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_s"
                android:progressDrawable="@drawable/progress_player"
                android:splitTrack="false"
                android:thumb="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playerPosition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#B3FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/playerDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#B3FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/playerPrevious"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/player_previous"
                    android:focusable="true"
                    android:nextFocusLeft="@id/playerBack"
                    android:nextFocusRight="@id/playerPlay"
                    android:nextFocusUp="@id/playerSeek"
                    android:src="@drawable/ic_previous"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/playerPlay"
                    android:layout_width="@dimen/player_play_size"
                    android:layout_height="@dimen/player_play_size"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginEnd="@dimen/space_s"
                    android:background="@drawable/bg_player_focus_ring"
                    android:contentDescription="@string/player_play"
                    android:focusable="true"
                    android:nextFocusLeft="@id/playerPrevious"
                    android:nextFocusRight="@id/playerNext"
                    android:nextFocusUp="@id/playerSeek"
                    android:padding="28dp"
                    android:src="@drawable/ic_play"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/playerNext"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/player_next"
                    android:focusable="true"
                    android:nextFocusLeft="@id/playerPlay"
                    android:nextFocusRight="@id/playerQueue"
                    android:nextFocusUp="@id/playerSeek"
                    android:src="@drawable/ic_next"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/playerRepeat"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_player_focus_control"
                    android:clickable="true"
                    android:contentDescription="@string/player_repeat_off"
                    android:focusable="true"
                    android:nextFocusRight="@id/playerQueue"
                    android:nextFocusUp="@id/playerPlay">

                    <ImageView
                        android:id="@+id/playerRepeatIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_infinity"
                        app:tint="@color/selector_player_repeat_tint" />

                    <TextView
                        android:id="@+id/playerRepeatOne"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/player_repeat_one_number"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/playerQueue"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/player_queue"
                    android:focusable="true"
                    android:nextFocusLeft="@id/playerRepeat"
                    android:nextFocusUp="@id/playerNext"
                    android:src="@drawable/ic_queue_music"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/playerError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="@string/player_error_stream"
                android:textColor="#FCA5A5"
                android:textSize="18sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerRetry"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:focusable="true"
                android:nextFocusUp="@id/playerPlay"
                android:text="@string/state_retry"
                android:visibility="gone"
                app:strokeColor="@color/selector_player_secondary_stroke"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerYouTubeLogin"
                style="@style/Widget.MystMusic.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:focusable="true"
                android:nextFocusUp="@id/playerPlay"
                android:text="@string/player_login_youtube"
                android:visibility="gone"
                app:strokeColor="@color/selector_player_primary_stroke"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerCopyLogs"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:focusable="true"
                android:nextFocusUp="@id/playerPlay"
                android:text="@string/player_copy_logs"
                android:visibility="gone"
                app:strokeColor="@color/selector_player_secondary_stroke"
                app:strokeWidth="2dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
