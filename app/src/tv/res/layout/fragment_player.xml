<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/playerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cover_placeholder" />

    <View
        android:id="@+id/playerTint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_tint" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/screen_margin_small"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/screen_margin_small">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/playerCover"
            android:layout_width="380dp"
            android:layout_height="380dp"
            android:background="@drawable/bg_cover_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.Cover" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/playerBack"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/auth_back"
                    android:focusable="true"
                    android:nextFocusDown="@id/playerArtist"
                    android:nextFocusRight="@id/playerMore"
                    android:src="@drawable/ic_back"
                    app:tint="@color/selector_player_control_tint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/player_now_playing"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/playerMore"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/player_add_playlist"
                    android:focusable="true"
                    android:nextFocusDown="@id/playerArtist"
                    android:nextFocusLeft="@id/playerBack"
                    android:src="@drawable/ic_add_to_playlist"
                    app:tint="@color/selector_player_control_tint" />
            </LinearLayout>

            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:maxLines="2"
                android:textColor="?attr/mystOnSurface"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/playerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_player_focus_text"
                android:ellipsize="end"
                android:maxLines="1"
                android:nextFocusDown="@id/playerSeek"
                android:nextFocusUp="@id/playerBack"
                android:padding="@dimen/space_s"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:textColor="@color/selector_player_artist_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/playerAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_player_focus_text"
                android:ellipsize="end"
                android:maxLines="1"
                android:nextFocusDown="@id/playerSeek"
                android:nextFocusUp="@id/playerArtist"
                android:padding="@dimen/space_xs"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:textColor="@color/selector_player_album_text"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/playerSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_player_focus_text"
                android:focusable="true"
                android:max="1000"
                android:minHeight="40dp"
                android:nextFocusDown="@id/playerPlay"
                android:nextFocusUp="@id/playerArtist"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_s"
                android:progressBackgroundTint="?attr/mystStrokeStrong"
                android:progressTint="?attr/mystAccentText"
                android:thumbTint="?attr/mystAccentText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playerPosition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/playerDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/playerShuffle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/player_shuffle"
                    android:focusable="true"
                    android:nextFocusRight="@id/playerPrevious"
                    android:nextFocusUp="@id/playerSeek"
                    android:src="@drawable/ic_shuffle"
                    app:tint="@color/selector_player_tint" />

                <ImageButton
                    android:id="@+id/playerPrevious"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/player_previous"
                    android:focusable="true"
                    android:nextFocusLeft="@id/playerShuffle"
                    android:nextFocusRight="@id/playerPlay"
                    android:nextFocusUp="@id/playerSeek"
                    android:src="@drawable/ic_previous"
                    app:tint="@color/selector_player_control_tint" />

                <ImageButton
                    android:id="@+id/playerPlay"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginEnd="@dimen/space_s"
                    android:background="@drawable/bg_player_play_focus"
                    android:contentDescription="@string/player_play"
                    android:focusable="true"
                    android:nextFocusLeft="@id/playerPrevious"
                    android:nextFocusRight="@id/playerNext"
                    android:nextFocusUp="@id/playerSeek"
                    android:padding="26dp"
                    android:src="@drawable/ic_play"
                    app:tint="?attr/mystOnAccent" />

                <ImageButton
                    android:id="@+id/playerNext"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/player_next"
                    android:focusable="true"
                    android:nextFocusLeft="@id/playerPlay"
                    android:nextFocusRight="@id/playerRepeat"
                    android:nextFocusUp="@id/playerSeek"
                    android:src="@drawable/ic_next"
                    app:tint="@color/selector_player_control_tint" />

                <ImageButton
                    android:id="@+id/playerRepeat"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="@drawable/bg_player_focus_control"
                    android:contentDescription="@string/player_repeat"
                    android:focusable="true"
                    android:nextFocusLeft="@id/playerNext"
                    android:nextFocusUp="@id/playerSeek"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/selector_player_tint" />
            </LinearLayout>

            <TextView
                android:id="@+id/playerError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:text="@string/player_error_stream"
                android:textColor="?attr/mystError"
                android:textSize="18sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerRetry"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:focusable="true"
                android:nextFocusUp="@id/playerPlay"
                android:text="@string/state_retry"
                android:visibility="gone"
                app:strokeColor="@color/selector_player_secondary_stroke"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerYouTubeLogin"
                style="@style/Widget.MystMusic.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:focusable="true"
                android:nextFocusUp="@id/playerPlay"
                android:text="@string/player_login_youtube"
                android:visibility="gone"
                app:strokeColor="@color/selector_player_primary_stroke"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerCopyLogs"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:focusable="true"
                android:nextFocusUp="@id/playerPlay"
                android:text="@string/player_copy_logs"
                android:visibility="gone"
                app:strokeColor="@color/selector_player_secondary_stroke"
                app:strokeWidth="2dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
