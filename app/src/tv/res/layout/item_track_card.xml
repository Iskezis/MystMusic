<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_m"
    android:background="@drawable/bg_track_row"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="204dp"
        android:layout_height="204dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/cardCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cover_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.Cover" />

        <com.iskezis.myst.ui.common.DownloadBadgeView
            android:id="@+id/cardDownloadBadge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/cardMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_more_circle"
            android:contentDescription="@string/common_more"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            app:tint="?attr/mystOnSurface" />

        <!-- O card inteiro já toca no controle remoto; o botão existe para o
             ViewBinding compartilhado com o flavor mobile. -->
        <ImageButton
            android:id="@+id/cardPlay"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:contentDescription="@string/player_play"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/cardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_medium"
        android:maxLines="1"
        android:textColor="?attr/mystOnSurface"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/cardArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="18sp" />
</LinearLayout>
