<?xml version="1.0" encoding="utf-8"?>
<!--
  A conta Myst, as playlists e o histórico ficam no banco Room e são incluídos
  no backup. A sessão criptografada NÃO é incluída: a chave do Android Keystore
  não sai do aparelho, então restaurar esse arquivo só produziria um cofre
  ilegível. Depois de restaurar, o usuário entra de novo e encontra a conta na
  lista "Contas neste aparelho".
-->
<full-backup-content>
    <exclude domain="sharedpref" path="myst_session.xml" />
    <exclude domain="sharedpref" path="myst_session_private.xml" />
    <!-- A URI externa do Mystaccount.json não vale em outro aparelho. -->
    <exclude domain="sharedpref" path="myst_account_file.xml" />
    <!-- A cópia interna é regenerada a partir do banco; não precisa viajar. -->
    <exclude domain="file" path="account/" />
    <exclude domain="file" path="logs/" />
    <exclude domain="file" path="myst_last_crash.txt" />
    <!-- Cookies do WebView e arquivos baixados não entram no backup. -->
    <exclude domain="root" path="app_webview/" />
    <exclude domain="file" path="downloads/" />
</full-backup-content>
