<?xml version="1.0" encoding="utf-8"?>
<!--
  Caminhos liberados somente pelo FileProvider interno. O arquivo de log fica
  no diretório privado do app e só é compartilhado quando o usuário toca em
  "Compartilhar" (a URI recebe permissão temporária de leitura).
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path
        name="external_logs"
        path="logs/" />
    <files-path
        name="internal_logs"
        path="logs/" />
</paths>
