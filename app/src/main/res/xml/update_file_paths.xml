<?xml version="1.0" encoding="utf-8"?>
<!--
  Caminho liberado somente pelo FileProvider de atualização. O APK fica em
  cacheDir/updates, é apagado ao concluir/errar e só é compartilhado com o
  instalador do Android pela URI concedida no Intent.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="updates"
        path="updates/" />
</paths>
