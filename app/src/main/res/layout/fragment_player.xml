<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mystBackground">

    <com.iskezis.myst.ui.common.CoverBackdropView
        android:id="@+id/playerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cover_placeholder" />

    <ScrollView
        android:id="@+id/playerScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin_small"
            android:paddingEnd="@dimen/screen_margin_small"
            android:paddingBottom="@dimen/content_bottom_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/playerBack"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_back"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/mystOnSurface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playerHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="0.12"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:text="@string/player_now_playing"
                        android:textAllCaps="true"
                        android:textColor="?attr/mystOnSurface"
                        android:textSize="@dimen/text_label" />

                    <TextView
                        android:id="@+id/playerHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:text="@string/app_name"
                        android:textColor="?attr/mystOnSurfaceDim"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="1dp" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/playerCover"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_cover_placeholder"
                    android:contentDescription="@null"
                    android:elevation="16dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.CoverLarge" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="-0.02"
                        android:maxLines="2"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:textColor="?attr/mystOnSurface"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/playerArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_medium"
                        android:maxLines="1"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:textColor="?attr/mystOnSurfaceDim"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/playerAlbum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:maxLines="1"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:textColor="?attr/mystOnSurfaceDim"
                        android:textSize="@dimen/text_small"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/playerMore"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_more"
                    android:padding="12dp"
                    android:src="@drawable/ic_more"
                    app:tint="?attr/mystOnSurface" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/playerSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginEnd="@dimen/space_xs"
                android:max="1000"
                android:maxHeight="@dimen/player_progress_height"
                android:minHeight="32dp"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:progressDrawable="@drawable/progress_player"
                android:splitTrack="false"
                android:thumb="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playerPosition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/playerDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/playerPrevious"
                    android:layout_width="@dimen/player_control"
                    android:layout_height="@dimen/player_control"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_previous"
                    android:padding="12dp"
                    android:src="@drawable/ic_previous"
                    app:tint="?attr/mystOnSurface" />

                <ImageButton
                    android:id="@+id/playerPlay"
                    android:layout_width="@dimen/player_play_size"
                    android:layout_height="@dimen/player_play_size"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_marginEnd="@dimen/space_m"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_play"
                    android:padding="20dp"
                    android:src="@drawable/ic_play"
                    app:tint="?attr/mystOnSurface" />

                <ImageButton
                    android:id="@+id/playerNext"
                    android:layout_width="@dimen/player_control"
                    android:layout_height="@dimen/player_control"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_next"
                    android:padding="12dp"
                    android:src="@drawable/ic_next"
                    app:tint="?attr/mystOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/playerRepeat"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/player_repeat_off"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/playerRepeatIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_infinity"
                        app:tint="@color/selector_player_repeat_tint" />

                    <TextView
                        android:id="@+id/playerRepeatOne"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="@string/player_repeat_one_number"
                        android:textColor="?attr/mystOnSurface"
                        android:textSize="9sp"
                        android:visibility="gone" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/playerQueue"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_queue"
                    android:padding="12dp"
                    android:src="@drawable/ic_queue_music"
                    app:tint="?attr/mystOnSurface" />
            </LinearLayout>

            <TextView
                android:id="@+id/playerError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="@string/player_error_stream"
                android:textColor="?attr/mystError"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerRetry"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/state_retry"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerYouTubeLogin"
                style="@style/Widget.MystMusic.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/player_login_youtube"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerCopyLogs"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/player_copy_logs"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/queueHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
