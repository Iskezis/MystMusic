<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchAlbumRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_s"
    android:layout_marginEnd="@dimen/space_s"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_track_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/track_row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_s"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/space_s"
    android:paddingBottom="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/searchAlbumCover"
        android:layout_width="@dimen/search_cover"
        android:layout_height="@dimen/search_cover"
        android:background="@drawable/bg_cover_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.CoverSmall" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/searchAlbumTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="1"
            android:textColor="?attr/mystOnSurface"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/searchAlbumSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_small" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/mystOnSurfaceDim" />
</LinearLayout>
