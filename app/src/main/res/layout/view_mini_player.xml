<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    app:cardBackgroundColor="?attr/mystGlass"
    app:cardCornerRadius="26dp"
    app:cardElevation="10dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_s">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/miniCover"
            android:layout_width="@dimen/mini_cover"
            android:layout_height="@dimen/mini_cover"
            android:background="@drawable/bg_cover_placeholder"
            android:contentDescription="@string/player_play"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.CoverSmall" />

        <TextView
            android:id="@+id/miniTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_s"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="1"
            android:textColor="?attr/mystOnSurface"
            android:textSize="@dimen/text_body"
            app:layout_constraintBottom_toTopOf="@id/miniArtist"
            app:layout_constraintEnd_toStartOf="@id/miniPlay"
            app:layout_constraintStart_toEndOf="@id/miniCover"
            app:layout_constraintTop_toTopOf="@id/miniCover" />

        <TextView
            android:id="@+id/miniArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_small"
            app:layout_constraintBottom_toBottomOf="@id/miniCover"
            app:layout_constraintEnd_toEndOf="@id/miniTitle"
            app:layout_constraintStart_toStartOf="@id/miniTitle"
            app:layout_constraintTop_toBottomOf="@id/miniTitle" />

        <ImageButton
            android:id="@+id/miniPlay"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_play_button"
            android:contentDescription="@string/player_play"
            android:padding="13dp"
            android:src="@drawable/ic_play"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/mystOnAccent" />

        <ProgressBar
            android:id="@+id/miniProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginStart="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_s"
            android:layout_marginBottom="5dp"
            android:max="1000"
            android:progressBackgroundTint="?attr/mystStroke"
            android:progressTint="?attr/mystAccent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
