<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_s">

    <TextView
        android:id="@+id/updateProgressTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/update_download_title"
        android:textColor="?attr/mystOnSurface"
        android:textSize="@dimen/text_title" />

    <TextView
        android:id="@+id/updateProgressVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:fontFamily="@font/poppins_medium"
        android:textColor="?attr/mystAccentText"
        android:textSize="@dimen/text_body" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/updateProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:indeterminate="false"
        android:max="100"
        app:indicatorColor="?attr/mystAccentText"
        app:trackColor="?attr/mystStroke"
        app:trackThickness="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateProgressBytes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_regular"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/updateProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="?attr/mystAccentText"
            android:textSize="@dimen/text_small" />
    </LinearLayout>
</LinearLayout>
