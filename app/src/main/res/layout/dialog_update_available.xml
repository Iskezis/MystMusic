<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_s">

    <TextView
        android:id="@+id/updateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/update_available_title"
        android:textColor="?attr/mystOnSurface"
        android:textSize="@dimen/text_title" />

    <TextView
        android:id="@+id/updateVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:fontFamily="@font/poppins_medium"
        android:textColor="?attr/mystAccentText"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/updateBetaBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:background="@drawable/bg_chip"
        android:fontFamily="@font/poppins_semibold"
        android:letterSpacing="0.08"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="2dp"
        android:text="@string/update_beta_badge"
        android:textAllCaps="true"
        android:textColor="?attr/mystAccentText"
        android:textSize="@dimen/text_label"
        android:visibility="gone" />

    <TextView
        android:id="@+id/updateSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:fontFamily="@font/poppins_regular"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="@dimen/text_small" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/update_notes_title"
        android:textColor="?attr/mystOnSurface"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/updateNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:fontFamily="@font/poppins_regular"
        android:lineSpacingExtra="3dp"
        android:maxLines="12"
        android:scrollbars="vertical"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="@dimen/text_small" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/update_install_signature_hint"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="@dimen/text_label" />
</LinearLayout>
