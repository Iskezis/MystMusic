<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBarRoot"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/nav_height"
    app:cardBackgroundColor="?attr/mystNavbarBg"
    app:cardCornerRadius="36dp"
    app:cardElevation="16dp"
    app:strokeColor="?attr/mystStroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_s">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="@dimen/nav_item_width"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/nav_home"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_home"
                app:tint="@color/nav_icon_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/nav_home"
                android:textColor="@color/nav_text_color"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPlaylists"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/nav_playlists"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs">

            <FrameLayout
                android:id="@+id/navCenterCard"
                android:layout_width="@dimen/nav_center_size"
                android:layout_height="@dimen/nav_center_size"
                android:background="@drawable/bg_gradient_circle"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_playlist"
                    app:tint="?attr/mystOnAccent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/nav_playlists"
                android:textColor="?attr/mystAccentText"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="@dimen/nav_item_width"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/nav_settings"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_settings"
                app:tint="@color/nav_icon_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/nav_settings"
                android:textColor="@color/nav_text_color"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
