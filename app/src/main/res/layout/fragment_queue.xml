<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/queueRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false">

    <com.iskezis.myst.ui.common.CoverBackdropView
        android:id="@+id/queueBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cover_placeholder" />

    <LinearLayout
        android:id="@+id/queueContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:id="@+id/queueHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/queueClose"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_queue_close"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/mystOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/queueTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/player_queue"
                    android:textColor="?attr/mystOnSurface"
                    android:textSize="@dimen/text_title" />

                <TextView
                    android:id="@+id/queueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/touch_target"
                android:layout_height="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/queueNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_s"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/queueNowCover"
                android:layout_width="@dimen/queue_now_cover"
                android:layout_height="@dimen/queue_now_cover"
                android:background="@drawable/bg_cover_placeholder"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_cover_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.CoverSmall" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/queueNowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:letterSpacing="0.06"
                    android:text="@string/player_now_playing"
                    android:textAllCaps="true"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:id="@+id/queueNowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="1"
                    android:textColor="?attr/mystOnSurface"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/queueNowArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <com.iskezis.myst.ui.player.QueueEqualizerView
                android:id="@+id/queueEqualizer"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:layout_marginStart="@dimen/space_s"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_s"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/queueList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_l"
                android:scrollbars="vertical" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/queueShimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/player_queue_loading"
                android:visibility="gone"
                app:shimmer_auto_start="false"
                app:shimmer_duration="1200">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_xs">

                    <include layout="@layout/item_queue_skeleton" />

                    <include layout="@layout/item_queue_skeleton" />

                    <include layout="@layout/item_queue_skeleton" />

                    <include layout="@layout/item_queue_skeleton" />

                    <include layout="@layout/item_queue_skeleton" />

                    <include layout="@layout/item_queue_skeleton" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <LinearLayout
                android:id="@+id/queueEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/screen_margin"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/queueEmptyIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_queue_music"
                    app:tint="?attr/mystOnSurfaceDim" />

                <TextView
                    android:id="@+id/queueEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="@string/player_queue_empty"
                    android:textColor="?attr/mystOnSurface"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/queueEmptyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="@string/player_queue_empty_hint"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/queueError"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/screen_margin"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/queueErrorIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cloud_off"
                    app:tint="?attr/mystOnSurfaceDim" />

                <TextView
                    android:id="@+id/queueErrorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="@string/player_queue_error"
                    android:textColor="?attr/mystOnSurface"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/queueRetry"
                    style="@style/Widget.MystMusic.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/state_retry" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
