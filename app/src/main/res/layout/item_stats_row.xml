<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_s"
    android:layout_marginEnd="@dimen/space_s"
    android:background="@drawable/bg_track_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/track_row_height"
    android:orientation="horizontal"
    android:padding="@dimen/space_s">

    <TextView
        android:id="@+id/statsRowRank"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="@dimen/text_small" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/statsRowCover"
        android:layout_width="@dimen/track_thumb"
        android:layout_height="@dimen/track_thumb"
        android:background="@drawable/bg_cover_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cover_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.Cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/statsRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="?attr/mystOnSurface"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/statsRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_small" />
    </LinearLayout>

    <TextView
        android:id="@+id/statsRowCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:textColor="?attr/mystAccentText"
        android:textSize="@dimen/text_small" />

    <ProgressBar
        android:id="@+id/statsRowProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/space_xs"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateTint="?attr/mystAccentText"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/statsRowAction"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/space_xs"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="?attr/mystAccentText" />
</LinearLayout>
