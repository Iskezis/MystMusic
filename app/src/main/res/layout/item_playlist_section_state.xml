<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_l">

    <ImageView
        android:id="@+id/sectionStateIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_cloud_off"
        app:tint="?attr/mystOnSurfaceDim" />

    <TextView
        android:id="@+id/sectionStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:textColor="?attr/mystOnSurface"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/sectionStateSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="@dimen/text_small"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sectionStateRetry"
        style="@style/Widget.MystMusic.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/state_retry"
        android:visibility="gone" />
</LinearLayout>
