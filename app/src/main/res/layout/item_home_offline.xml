<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_margin"
    android:layout_marginTop="@dimen/space_m"
    android:layout_marginEnd="@dimen/screen_margin"
    app:cardBackgroundColor="?attr/mystSurface"
    app:cardCornerRadius="@dimen/corner_medium"
    app:cardElevation="0dp"
    app:strokeColor="?attr/mystStroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cloud_off"
            app:tint="?attr/mystAccentText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/home_offline_title"
            android:textColor="?attr/mystOnSurface"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/home_offline_subtitle"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeOfflineRetry"
            style="@style/Widget.MystMusic.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/home_offline_retry" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
