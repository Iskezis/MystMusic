<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/pairing_tv_title"
            android:textColor="?attr/mystOnSurface"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:text="@string/pairing_tv_waiting"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvPairStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:text="@string/pairing_tv_no_request"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:fontFamily="sans-serif-medium"
            android:text="@string/pairing_tv_pin_title"
            android:textColor="?attr/mystOnSurface"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvPairCode"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_code_box"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.22"
            android:text="_____"
            android:textColor="?attr/mystAccentText"
            android:textSize="46sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/pairing_tv_seconds"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="16sp" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:columnCount="3"
            android:rowCount="4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey1"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="1"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey2"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="2"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey3"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="3"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey4"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="4"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey5"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="5"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey6"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="6"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey7"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="7"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey8"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="8"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey9"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="9"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKeyBack"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="@string/pairing_tv_backspace"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvKey0"
                style="@style/Widget.MystMusic.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="0"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvPairConfirm"
                style="@style/Widget.MystMusic.Button.Primary"
                android:layout_width="132dp"
                android:layout_height="62dp"
                android:layout_margin="6dp"
                android:text="@string/pairing_tv_confirm"
                android:textSize="18sp" />
        </GridLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvPairRetry"
            style="@style/Widget.MystMusic.Button.Secondary"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/pairing_tv_retry"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPairService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:text="@string/pairing_tv_service"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
