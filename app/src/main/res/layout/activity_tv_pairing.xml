<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true"
    android:focusable="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_m">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="?attr/mystAccentText"
            android:textSize="@dimen/text_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="-0.02"
            android:gravity="center"
            android:text="@string/pairing_tv_title"
            android:textColor="?attr/mystOnSurface"
            android:textSize="@dimen/text_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/pairing_tv_waiting"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvPairStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/pairing_tv_no_request"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/pairing_tv_pin_title"
                    android:textColor="?attr/mystOnSurface"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvPairCode"
                    android:layout_width="@dimen/pairing_code_width"
                    android:layout_height="@dimen/pairing_code_height"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_code_box"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.22"
                    android:text="_____"
                    android:textColor="?attr/mystAccentText"
                    android:textSize="@dimen/pairing_code_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/pairing_tv_seconds"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="@dimen/text_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvPairRetry"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_retry_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/pairing_tv_retry"
                    android:visibility="gone" />
            </LinearLayout>

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:columnCount="3"
                android:rowCount="4">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey1"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusDown="@id/tvKey4"
                    android:nextFocusRight="@id/tvKey2"
                    android:text="1"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey2"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusDown="@id/tvKey5"
                    android:nextFocusLeft="@id/tvKey1"
                    android:nextFocusRight="@id/tvKey3"
                    android:text="2"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey3"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusDown="@id/tvKey6"
                    android:nextFocusLeft="@id/tvKey2"
                    android:text="3"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey4"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusDown="@id/tvKey7"
                    android:nextFocusRight="@id/tvKey5"
                    android:nextFocusUp="@id/tvKey1"
                    android:text="4"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey5"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusDown="@id/tvKey8"
                    android:nextFocusLeft="@id/tvKey4"
                    android:nextFocusRight="@id/tvKey6"
                    android:nextFocusUp="@id/tvKey2"
                    android:text="5"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey6"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusDown="@id/tvKey9"
                    android:nextFocusLeft="@id/tvKey5"
                    android:nextFocusUp="@id/tvKey3"
                    android:text="6"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey7"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusDown="@id/tvKeyBack"
                    android:nextFocusRight="@id/tvKey8"
                    android:nextFocusUp="@id/tvKey4"
                    android:text="7"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey8"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusDown="@id/tvKey0"
                    android:nextFocusLeft="@id/tvKey7"
                    android:nextFocusRight="@id/tvKey9"
                    android:nextFocusUp="@id/tvKey5"
                    android:text="8"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey9"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusDown="@id/tvPairConfirm"
                    android:nextFocusLeft="@id/tvKey8"
                    android:nextFocusUp="@id/tvKey6"
                    android:text="9"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKeyBack"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusRight="@id/tvKey0"
                    android:nextFocusUp="@id/tvKey7"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs"
                    android:text="@string/pairing_tv_backspace"
                    android:textSize="@dimen/text_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvKey0"
                    style="@style/Widget.MystMusic.Button.Secondary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusLeft="@id/tvKeyBack"
                    android:nextFocusRight="@id/tvPairConfirm"
                    android:nextFocusUp="@id/tvKey8"
                    android:text="0"
                    android:textSize="@dimen/pairing_key_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvPairConfirm"
                    style="@style/Widget.MystMusic.Button.Primary"
                    android:layout_width="@dimen/pairing_key_width"
                    android:layout_height="@dimen/pairing_key_height"
                    android:layout_margin="@dimen/pairing_key_margin"
                    android:nextFocusLeft="@id/tvKey0"
                    android:nextFocusUp="@id/tvKey9"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs"
                    android:text="@string/pairing_tv_confirm"
                    android:textSize="@dimen/text_small" />
            </GridLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPairService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/pairing_tv_service"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_small" />
    </LinearLayout>
</ScrollView>
