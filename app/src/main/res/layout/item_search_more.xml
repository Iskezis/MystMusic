<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="@dimen/touch_target"
    android:orientation="horizontal"
    android:padding="@dimen/space_m">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/searchMoreProgress"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/mystAccentText"
        app:indicatorSize="20dp"
        app:trackThickness="2dp" />

    <TextView
        android:id="@+id/searchMoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:text="@string/search_load_more"
        android:textColor="?attr/mystAccentText"
        android:textSize="@dimen/text_small" />
</LinearLayout>
