<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/appearanceContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/content_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/appearanceBack"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_back"
                android:src="@drawable/ic_back"
                app:tint="?attr/mystOnSurface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/appearance_title"
                android:textColor="?attr/mystOnSurface"
                android:textSize="28sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/appearance_subtitle"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_body" />

        <RadioGroup
            android:id="@+id/appearanceThemeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appearanceCardSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="?attr/mystSurface"
                app:cardCornerRadius="@dimen/corner_large"
                app:cardElevation="0dp"
                app:strokeColor="@color/appearance_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="88dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_preview_outline"
                        android:clipToOutline="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_preview_light_half" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_preview_dark_half" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/appearance_theme_system"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/appearance_theme_system_desc"
                            android:textColor="?attr/mystOnSurfaceDim"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/appearanceRadioSystem"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target"
                        android:buttonTint="?attr/mystAccentText"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appearanceCardLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="?attr/mystSurface"
                app:cardCornerRadius="@dimen/corner_large"
                app:cardElevation="0dp"
                app:strokeColor="@color/appearance_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="88dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_preview_light">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="@dimen/space_s"
                            android:layout_marginEnd="@dimen/space_s"
                            android:background="@drawable/bg_preview_dot" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="4dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_marginBottom="@dimen/space_s"
                            android:background="@drawable/bg_preview_bar" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/appearance_theme_light"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/appearance_theme_light_desc"
                            android:textColor="?attr/mystOnSurfaceDim"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/appearanceRadioLight"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target"
                        android:buttonTint="?attr/mystAccentText"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appearanceCardDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="?attr/mystSurface"
                app:cardCornerRadius="@dimen/corner_large"
                app:cardElevation="0dp"
                app:strokeColor="@color/appearance_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="88dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_preview_dark">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="@dimen/space_s"
                            android:layout_marginEnd="@dimen/space_s"
                            android:background="@drawable/bg_preview_dot" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="4dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_marginBottom="@dimen/space_s"
                            android:background="@drawable/bg_preview_bar" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/appearance_theme_dark"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/appearance_theme_dark_desc"
                            android:textColor="?attr/mystOnSurfaceDim"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/appearanceRadioDark"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target"
                        android:buttonTint="?attr/mystAccentText"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </RadioGroup>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/appearanceAmoledRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/mystSurface"
            app:cardCornerRadius="@dimen/corner_large"
            app:cardElevation="0dp"
            app:strokeColor="?attr/mystStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="88dp"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/appearance_amoled"
                        android:textColor="?attr/mystOnSurface"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/appearance_amoled_desc"
                        android:textColor="?attr/mystOnSurfaceDim"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/appearanceAmoledSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:contentDescription="@string/appearance_amoled"
                    app:thumbTint="?attr/mystAccent"
                    app:trackTint="?attr/mystAccentAlpha24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/appearance_device_note"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_small" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
