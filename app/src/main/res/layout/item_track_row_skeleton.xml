<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingEnd="@dimen/screen_margin">

    <View
        android:layout_width="@dimen/track_thumb"
        android:layout_height="@dimen/track_thumb"
        android:background="@drawable/bg_skeleton" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="180dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="110dp"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_skeleton" />
    </LinearLayout>
</LinearLayout>
