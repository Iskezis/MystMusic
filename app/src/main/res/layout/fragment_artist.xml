<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/artistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/artistTopBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/artistBack"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_back"
            android:src="@drawable/ic_back"
            app:tint="?attr/mystOnSurface" />

        <TextView
            android:id="@+id/artistBarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="1"
            android:textColor="?attr/mystOnSurface"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/artistFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/artistTopBar">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/artistScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/content_bottom_padding_playing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/screen_margin">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/artistCover"
                        android:layout_width="@dimen/artist_cover"
                        android:layout_height="@dimen/artist_cover"
                        android:background="@drawable/bg_cover_placeholder"
                        android:contentDescription="@null"
                        android:elevation="8dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.Circle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:letterSpacing="0.12"
                            android:text="@string/browse_artist"
                            android:textAllCaps="true"
                            android:textColor="?attr/mystAccentText"
                            android:textSize="@dimen/text_label" />

                        <TextView
                            android:id="@+id/artistName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins_semibold"
                            android:letterSpacing="-0.03"
                            android:maxLines="3"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="30sp" />

                        <TextView
                            android:id="@+id/artistListeners"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="?attr/mystOnSurfaceDim"
                            android:textSize="@dimen/text_small"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/screen_margin">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/artistPlayAll"
                        style="@style/Widget.MystMusic.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/playlist_play_all"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/mystOnAccent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/artistShuffle"
                        style="@style/Widget.MystMusic.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:text="@string/playlist_shuffle"
                        app:icon="@drawable/ic_shuffle"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/mystAccentText" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/artistDownload"
                    style="@style/Widget.MystMusic.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/space_s"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:text="@string/download_all_artist"
                    app:icon="@drawable/ic_arrow_down"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/mystAccentText" />

                <LinearLayout
                    android:id="@+id/artistSongsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_l"
                        android:paddingEnd="@dimen/space_s">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_semibold"
                            android:letterSpacing="-0.01"
                            android:text="@string/browse_top_songs"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="@dimen/text_section" />

                        <TextView
                            android:id="@+id/artistSeeAll"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_target"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:minWidth="@dimen/touch_target"
                            android:paddingStart="@dimen/space_s"
                            android:paddingEnd="@dimen/space_s"
                            android:text="@string/browse_see_all"
                            android:textColor="?attr/mystAccentText"
                            android:textSize="@dimen/text_small"
                            android:visibility="gone" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/artistTopTracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingTop="@dimen/space_s" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/artistAlbumsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="-0.01"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_l"
                        android:paddingEnd="@dimen/screen_margin"
                        android:text="@string/browse_albums"
                        android:textColor="?attr/mystOnSurface"
                        android:textSize="@dimen/text_section" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/artistAlbumsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/screen_margin" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/artistSinglesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="-0.01"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_l"
                        android:paddingEnd="@dimen/screen_margin"
                        android:text="@string/browse_singles"
                        android:textColor="?attr/mystOnSurface"
                        android:textSize="@dimen/text_section" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/artistSinglesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/screen_margin" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/artistPlaylistsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="-0.01"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_l"
                        android:paddingEnd="@dimen/screen_margin"
                        android:text="@string/browse_playlists"
                        android:textColor="?attr/mystOnSurface"
                        android:textSize="@dimen/text_section" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/artistPlaylistsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/screen_margin" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/artistRelatedSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="-0.01"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_l"
                        android:paddingEnd="@dimen/screen_margin"
                        android:text="@string/browse_related"
                        android:textColor="?attr/mystOnSurface"
                        android:textSize="@dimen/text_section" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/artistRelatedList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/screen_margin" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/artistAboutSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingTop="@dimen/space_l"
                    android:paddingEnd="@dimen/screen_margin"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="-0.01"
                        android:text="@string/browse_about"
                        android:textColor="?attr/mystOnSurface"
                        android:textSize="@dimen/text_section" />

                    <TextView
                        android:id="@+id/artistAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="2dp"
                        android:textColor="?attr/mystOnSurfaceDim"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/artistShimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_l"
                android:paddingEnd="@dimen/screen_margin">

                <View
                    android:layout_width="@dimen/artist_cover"
                    android:layout_height="@dimen/artist_cover"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_skeleton" />

                <include
                    layout="@layout/item_track_row_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/track_row_height"
                    android:layout_marginTop="@dimen/space_l" />

                <include
                    layout="@layout/item_track_row_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/track_row_height" />

                <include
                    layout="@layout/item_track_row_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/track_row_height" />

                <include
                    layout="@layout/item_track_row_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/track_row_height" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <include
            android:id="@+id/artistState"
            layout="@layout/view_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
