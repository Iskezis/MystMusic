<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/screen_margin_small"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/phonePairBack"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_back"
                android:src="@drawable/ic_back"
                app:tint="?attr/mystOnSurface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="-0.01"
                android:text="@string/pairing_title"
                android:textColor="?attr/mystOnSurface"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="?attr/mystAccentText"
            android:textSize="@dimen/text_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/pairing_phone_help"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/phonePairProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:indeterminate="true"
            app:indicatorColor="?attr/mystAccentText"
            app:trackColor="?attr/mystStroke"
            app:trackThickness="3dp" />

        <TextView
            android:id="@+id/phonePairStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/pairing_searching"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/phonePairCodeRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/mystSurfaceAlt"
            app:cardCornerRadius="@dimen/corner_xlarge"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/pairing_code_title"
                    android:textColor="?attr/mystOnSurface"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/phonePairCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_code_box"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.24"
                    android:paddingStart="@dimen/space_l"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/space_l"
                    android:paddingBottom="@dimen/space_m"
                    android:textColor="?attr/mystAccentText"
                    android:textSize="40sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/pairing_code_help"
                    android:textColor="?attr/mystOnSurfaceDim"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/phonePairNone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/pairing_none"
            android:textColor="?attr/mystOnSurfaceDim"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/phonePairTvList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/phonePairRetry"
            style="@style/Widget.MystMusic.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/pairing_retry"
            app:icon="@drawable/ic_sync"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_s" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
