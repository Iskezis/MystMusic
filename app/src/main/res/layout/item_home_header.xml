<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_gradient_circle">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_music"
                app:tint="?attr/mystOnAccent" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="?attr/mystOnSurface"
            android:textSize="21sp" />

        <ImageButton
            android:id="@+id/homeStatsButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_circle_tonal"
            android:contentDescription="@string/stats_open"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_stats"
            app:tint="?attr/mystAccentText" />

        <FrameLayout
            android:id="@+id/homeHeaderAvatarFrame"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/bg_avatar"
            android:clickable="true"
            android:contentDescription="@string/nav_settings"
            android:focusable="true">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/homeHeaderAvatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.Circle" />

            <TextView
                android:id="@+id/homeHeaderInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="?attr/mystAccentText"
                android:textSize="17sp" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/homeGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semibold"
        android:letterSpacing="-0.03"
        android:maxLines="2"
        android:textColor="?attr/mystOnSurface"
        android:textSize="32sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/home_greeting_subtitle"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="@dimen/text_body" />
</LinearLayout>
