<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentGridList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/recentGridShimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_s"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_color="?attr/mystSurfaceAlt"
            app:shimmer_highlight_color="?attr/mystSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    layout="@layout/item_track_row_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/track_row_height" />

                <include
                    layout="@layout/item_track_row_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/track_row_height" />

                <include
                    layout="@layout/item_track_row_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/track_row_height" />

                <include
                    layout="@layout/item_track_row_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/track_row_height" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <include
            android:id="@+id/recentGridState"
            layout="@layout/view_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/recentGridDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/space_s"
        android:visibility="gone" />
</LinearLayout>
