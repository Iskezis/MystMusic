<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/avatarCropRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/avatar_crop_bg">

    <com.iskezis.myst.ui.common.AvatarCropView
        android:id="@+id/avatarCropView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/avatar_crop_hint"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/avatarCropTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s">

        <ImageButton
            android:id="@+id/avatarCropCancel"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/avatar_crop_cancel"
            android:src="@drawable/ic_close"
            app:tint="?attr/mystOnImage" />

        <TextView
            android:id="@+id/avatarCropTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/avatar_crop_title"
            android:textColor="?attr/mystOnImage"
            android:textSize="20sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/avatarCropSave"
            style="@style/Widget.MystMusic.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:enabled="false"
            android:text="@string/avatar_crop_save" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/avatarCropProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="?attr/mystOnImage"
        app:trackColor="@color/avatar_crop_track" />

    <LinearLayout
        android:id="@+id/avatarCropErrorRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_error"
            app:tint="?attr/mystOnImage" />

        <TextView
            android:id="@+id/avatarCropError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:text="@string/avatar_crop_error"
            android:textColor="?attr/mystOnImage"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/avatarCropRetry"
            style="@style/Widget.MystMusic.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/state_retry" />
    </LinearLayout>

    <TextView
        android:id="@+id/avatarCropHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:padding="@dimen/space_m"
        android:text="@string/avatar_crop_hint"
        android:textColor="?attr/mystOnImage"
        android:textSize="@dimen/text_small" />
</FrameLayout>
