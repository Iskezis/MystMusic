<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:fontFamily="@font/poppins_semibold"
        android:letterSpacing="0.12"
        android:text="@string/app_name"
        android:textAllCaps="true"
        android:textColor="?attr/mystAccentText"
        android:textSize="@dimen/text_label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/statsBack"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/mystOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="-0.02"
            android:text="@string/stats_title"
            android:textColor="?attr/mystOnSurface"
            android:textSize="30sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/stats_subtitle"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="@dimen/text_small" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/statsPeriods"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/statsChipWeek"
                style="@style/Widget.MystMusic.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:minHeight="@dimen/touch_target"
                android:text="@string/stats_period_week"
                android:textSize="@dimen/text_small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/statsChipMonth"
                style="@style/Widget.MystMusic.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:minHeight="@dimen/touch_target"
                android:text="@string/stats_period_month"
                android:textSize="@dimen/text_small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/statsChipYear"
                style="@style/Widget.MystMusic.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:minHeight="@dimen/touch_target"
                android:text="@string/stats_period_year"
                android:textSize="@dimen/text_small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/statsChipAll"
                style="@style/Widget.MystMusic.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:minHeight="@dimen/touch_target"
                android:text="@string/stats_period_all"
                android:textSize="@dimen/text_small" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/statsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/statsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/content_bottom_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MystMusic.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_m">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_time_label"
                                android:textColor="?attr/mystOnSurfaceDim"
                                android:textSize="@dimen/text_small" />

                            <TextView
                                android:id="@+id/statsTimeValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:fontFamily="@font/poppins_medium"
                                android:maxLines="2"
                                android:textColor="?attr/mystOnSurface"
                                android:textSize="26sp" />

                            <TextView
                                android:id="@+id/statsTimeCompare"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:textColor="?attr/mystAccentText"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MystMusic.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_m">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_plays_label"
                                android:textColor="?attr/mystOnSurfaceDim"
                                android:textSize="@dimen/text_small" />

                            <TextView
                                android:id="@+id/statsPlaysValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:fontFamily="@font/poppins_medium"
                                android:textColor="?attr/mystOnSurface"
                                android:textSize="26sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/stats_plays_hint"
                                android:textColor="?attr/mystOnSurfaceDim"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.MystMusic.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/stats_top_songs"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="@dimen/text_title" />

                        <LinearLayout
                            android:id="@+id/statsTopTracks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.MystMusic.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/stats_top_artists"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="@dimen/text_title" />

                        <LinearLayout
                            android:id="@+id/statsTopArtists"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.MystMusic.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/stats_top_albums"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="@dimen/text_title" />

                        <LinearLayout
                            android:id="@+id/statsTopAlbums"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.MystMusic.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/stats_hour_title"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="@dimen/text_title" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_hour_subtitle"
                            android:textColor="?attr/mystOnSurfaceDim"
                            android:textSize="@dimen/text_small" />

                        <com.iskezis.myst.ui.stats.BarChartView
                            android:id="@+id/statsHourChart"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginTop="@dimen/space_s"
                            android:importantForAccessibility="yes" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.MystMusic.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/stats_activity_title"
                            android:textColor="?attr/mystOnSurface"
                            android:textSize="@dimen/text_title" />

                        <TextView
                            android:id="@+id/statsActivitySubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/mystOnSurfaceDim"
                            android:textSize="@dimen/text_small" />

                        <com.iskezis.myst.ui.stats.BarChartView
                            android:id="@+id/statsActivityChart"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginTop="@dimen/space_s"
                            android:importantForAccessibility="yes" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.MystMusic.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_streak_current"
                                android:textColor="?attr/mystOnSurfaceDim"
                                android:textSize="@dimen/text_small" />

                            <TextView
                                android:id="@+id/statsStreakCurrent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:fontFamily="@font/poppins_medium"
                                android:textColor="?attr/mystOnSurface"
                                android:textSize="26sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_marginEnd="@dimen/space_m"
                            android:background="?attr/mystStroke" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_streak_record"
                                android:textColor="?attr/mystOnSurfaceDim"
                                android:textSize="@dimen/text_small" />

                            <TextView
                                android:id="@+id/statsStreakRecord"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:fontFamily="@font/poppins_medium"
                                android:textColor="?attr/mystOnSurface"
                                android:textSize="26sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/statsShimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/screen_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>

                <View
                    android:layout_width="180dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <include
            android:id="@+id/statsState"
            layout="@layout/view_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
