<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/artistCardRoot"
    android:layout_width="@dimen/card_cover"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_m"
    android:background="@drawable/bg_track_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/artistCardCover"
        android:layout_width="@dimen/browse_card_cover"
        android:layout_height="@dimen/browse_card_cover"
        android:background="@drawable/bg_cover_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.Circle" />

    <TextView
        android:id="@+id/artistCardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="?attr/mystOnSurface"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/artistCardSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="@dimen/text_small" />
</LinearLayout>
