<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_m"
    android:background="@drawable/bg_track_row"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="132dp"
        android:layout_height="132dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/cardCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cover_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MystMusic.Cover" />

        <com.iskezis.myst.ui.common.DownloadBadgeView
            android:id="@+id/cardDownloadBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/cardMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_more_circle"
            android:contentDescription="@string/common_more"
            android:padding="6dp"
            android:src="@drawable/ic_more"
            app:tint="?attr/mystOnSurface" />
    </FrameLayout>

    <TextView
        android:id="@+id/cardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="?attr/mystOnSurface"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/cardArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/mystOnSurfaceDim"
        android:textSize="@dimen/text_small" />
</LinearLayout>
