<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.iskezis.myst.ui.home.HomeFragment"
        android:label="@string/nav_home" />

    <fragment
        android:id="@+id/playlistsFragment"
        android:name="com.iskezis.myst.ui.playlists.PlaylistsFragment"
        android:label="@string/nav_playlists" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.iskezis.myst.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/appearanceFragment"
        android:name="com.iskezis.myst.ui.settings.AppearanceFragment"
        android:label="@string/settings_appearance" />

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.iskezis.myst.ui.stats.StatsFragment"
        android:label="@string/stats_title" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.iskezis.myst.ui.search.SearchFragment"
        android:label="@string/search_title">
        <argument
            android:name="initialQuery"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.iskezis.myst.ui.player.PlayerFragment"
        android:label="@string/player_now_playing" />

    <fragment
        android:id="@+id/playlistDetailFragment"
        android:name="com.iskezis.myst.ui.playlists.PlaylistDetailFragment"
        android:label="@string/playlists_title">
        <argument
            android:name="playlistId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/ytPlaylistDetailFragment"
        android:name="com.iskezis.myst.ui.playlists.YtPlaylistDetailFragment"
        android:label="@string/playlists_youtube_section">
        <argument
            android:name="ytId"
            app:argType="string" />
        <argument
            android:name="ytTitle"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="ytThumbnail"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/artistFragment"
        android:name="com.iskezis.myst.ui.browse.ArtistFragment"
        android:label="@string/browse_artist">
        <argument
            android:name="artistId"
            app:argType="string" />
        <argument
            android:name="artistName"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="artistThumbnail"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/albumFragment"
        android:name="com.iskezis.myst.ui.browse.AlbumFragment"
        android:label="@string/browse_album">
        <argument
            android:name="albumId"
            app:argType="string" />
        <argument
            android:name="albumTitle"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="albumArtist"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="albumThumbnail"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/publicPlaylistFragment"
        android:name="com.iskezis.myst.ui.browse.PublicPlaylistFragment"
        android:label="@string/browse_playlist">
        <argument
            android:name="playlistId"
            app:argType="string" />
        <argument
            android:name="playlistTitle"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="playlistThumbnail"
            android:defaultValue=""
            app:argType="string" />
    </fragment>
</navigation>
