<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.iskezis.myst.ui.home.HomeFragment"
        android:label="@string/nav_home" />

    <fragment
        android:id="@+id/playlistsFragment"
        android:name="com.iskezis.myst.ui.playlists.PlaylistsFragment"
        android:label="@string/nav_playlists" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.iskezis.myst.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.iskezis.myst.ui.search.SearchFragment"
        android:label="@string/search_title" />

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.iskezis.myst.ui.player.PlayerFragment"
        android:label="@string/player_now_playing" />

    <fragment
        android:id="@+id/playlistDetailFragment"
        android:name="com.iskezis.myst.ui.playlists.PlaylistDetailFragment"
        android:label="@string/playlists_title">
        <argument
            android:name="playlistId"
            app:argType="long" />
    </fragment>
</navigation>
