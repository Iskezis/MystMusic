<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MystMusic" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/sky_400</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorPrimaryContainer">@color/sky_500</item>
        <item name="colorOnPrimaryContainer">@color/bg</item>
        <item name="colorSecondary">@color/sky_500</item>
        <item name="colorOnSecondary">@color/text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MystMusic.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MystMusic.BottomSheet</item>
        <item name="android:windowAnimationStyle">@style/Animation.MystMusic.Window</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="ThemeOverlay.MystMusic.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_alt</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorPrimary">@color/sky_400</item>
        <item name="android:windowBackground">@color/transparent</item>
    </style>

    <style name="ThemeOverlay.MystMusic.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MystMusic.BottomSheet</item>
        <item name="android:windowBackground">@color/transparent</item>
    </style>

    <style name="Widget.MystMusic.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_alt</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MystMusic.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.MystMusic.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Animation.MystMusic.Window" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_fade_out</item>
    </style>

    <style name="Theme.MystMusic.Auth" parent="Theme.MystMusic">
        <item name="android:windowBackground">@drawable/bg_auth</item>
    </style>

    <style name="Theme.MystMusic.Tv" parent="Theme.MystMusic">
        <item name="android:windowBackground">@drawable/bg_app</item>
    </style>

    <style name="TextAppearance.MystMusic.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MystMusic.Section" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MystMusic.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.MystMusic.Dim" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="Widget.MystMusic.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/sky_400</item>
        <item name="android:textColor">@color/bg</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">@color/bg</item>
    </style>

    <style name="Widget.MystMusic.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/sky_200</item>
        <item name="strokeColor">@color/white_20</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">@color/sky_200</item>
    </style>

    <style name="Widget.MystMusic.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/corner_medium</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/white_8</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.MystMusic.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_text_input_stroke</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_medium</item>
        <item name="hintTextColor">@color/sky_400</item>
        <item name="android:textColorHint">@color/text_dim</item>
    </style>
</resources>
