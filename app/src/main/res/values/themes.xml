<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Tema base comum. As variantes clara/escura ficam em values/themes.xml e
      values-night/themes.xml; o overlay AMOLED é aplicado antes de super.onCreate.
    -->
    <style name="Theme.MystMusic.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MystMusic.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MystMusic.BottomSheet</item>
        <item name="android:windowAnimationStyle">@style/Animation.MystMusic.Window</item>
    </style>

    <style name="Theme.MystMusic" parent="Theme.MystMusic.Base">
        <item name="colorPrimary">@color/light_accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/sky_400</item>
        <item name="colorOnPrimaryContainer">@color/on_accent</item>
        <item name="colorSecondary">@color/light_accent_text</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text</item>
        <item name="colorSurfaceVariant">@color/light_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/light_text_dim</item>
        <item name="colorOutline">@color/light_stroke_strong</item>
        <item name="colorError">@color/light_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorControlNormal">@color/light_text_dim</item>
        <item name="colorControlActivated">@color/light_accent</item>
        <item name="colorControlHighlight">@color/accent_alpha_24</item>
        <item name="android:colorBackground">@color/light_bg</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_text_dim</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="mystBackground">@color/light_bg</item>
        <item name="mystSurface">@color/light_surface</item>
        <item name="mystSurfaceAlt">@color/light_surface_alt</item>
        <item name="mystOnSurface">@color/light_text</item>
        <item name="mystOnSurfaceDim">@color/light_text_dim</item>
        <item name="mystNavbarBg">@color/light_navbar</item>
        <item name="mystStroke">@color/light_stroke</item>
        <item name="mystStrokeStrong">@color/light_stroke_strong</item>
        <item name="mystGradientStart">@color/light_bg</item>
        <item name="mystGradientEnd">@color/light_surface_alt</item>
        <item name="mystAccent">@color/light_accent</item>
        <item name="mystAccentDark">@color/light_accent_dark</item>
        <item name="mystAccentText">@color/light_accent_text</item>
        <item name="mystOnAccent">@color/on_accent</item>
        <item name="mystOnImage">@color/on_image</item>
        <item name="mystImageScrim">@color/image_scrim</item>
        <item name="mystPlayerScrim">@color/light_player_scrim</item>
        <item name="mystError">@color/light_error</item>
        <item name="mystSuccess">@color/light_success</item>
        <item name="mystAccentAlpha16">@color/accent_alpha_16</item>
        <item name="mystAccentAlpha24">@color/accent_alpha_24</item>
        <item name="mystHeroStart">@color/light_hero_start</item>
        <item name="mystHeroEnd">@color/light_hero_end</item>
        <item name="mystGlass">@color/light_glass</item>
    </style>

    <!--
        O overlay AMOLED também existe na configuração clara. Ele só é
        aplicado quando o tema efetivo é escuro, mas precisa funcionar mesmo
        se a Activity estiver sendo criada antes da recriação do modo noturno.
    -->
    <style name="ThemeOverlay.MystMusic.Amoled" parent="">
        <item name="mystBackground">@color/amoled_bg</item>
        <item name="mystSurface">@color/amoled_surface</item>
        <item name="mystSurfaceAlt">@color/amoled_surface_alt</item>
        <item name="mystOnSurface">@color/dark_text</item>
        <item name="mystOnSurfaceDim">@color/dark_text_dim</item>
        <item name="mystNavbarBg">@color/amoled_navbar</item>
        <item name="mystStroke">@color/amoled_stroke</item>
        <item name="mystStrokeStrong">@color/amoled_stroke_strong</item>
        <item name="mystGradientStart">@color/amoled_bg</item>
        <item name="mystGradientEnd">@color/amoled_surface</item>
        <item name="mystAccent">@color/dark_accent</item>
        <item name="mystAccentDark">@color/dark_accent_dark</item>
        <item name="mystAccentText">@color/dark_accent_text</item>
        <item name="mystOnAccent">@color/on_accent</item>
        <item name="mystOnImage">@color/on_image</item>
        <item name="mystImageScrim">@color/image_scrim</item>
        <item name="mystPlayerScrim">@color/amoled_player_scrim</item>
        <item name="mystError">@color/dark_error</item>
        <item name="mystSuccess">@color/dark_success</item>
        <item name="mystAccentAlpha16">@color/accent_alpha_16</item>
        <item name="mystAccentAlpha24">@color/accent_alpha_24</item>
        <item name="mystHeroStart">@color/amoled_hero_start</item>
        <item name="mystHeroEnd">@color/amoled_hero_end</item>
        <item name="mystGlass">@color/amoled_glass</item>

        <item name="android:colorBackground">@color/amoled_bg</item>
        <item name="colorSurface">@color/amoled_surface</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorSurfaceVariant">@color/amoled_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_dim</item>
        <item name="colorOutline">@color/amoled_stroke_strong</item>
        <item name="colorControlNormal">@color/dark_text_dim</item>
        <item name="colorControlActivated">@color/dark_accent</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text_dim</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="ThemeOverlay.MystMusic.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/mystSurfaceAlt</item>
        <item name="colorOnSurface">?attr/mystOnSurface</item>
        <item name="colorPrimary">?attr/mystAccentText</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.MystMusic.Dialog</item>
    </style>

    <style name="Animation.MystMusic.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/screen_fade_out</item>
    </style>

    <style name="ThemeOverlay.MystMusic.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MystMusic.BottomSheet</item>
        <item name="android:windowBackground">@color/transparent</item>
    </style>

    <style name="Widget.MystMusic.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/mystSurfaceAlt</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MystMusic.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.MystMusic.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Animation.MystMusic.Window" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_fade_out</item>
    </style>

    <style name="Theme.MystMusic.Auth" parent="Theme.MystMusic">
        <item name="android:windowBackground">@drawable/bg_auth</item>
    </style>

    <style name="Theme.MystMusic.Tv" parent="Theme.MystMusic">
        <item name="android:windowBackground">@drawable/bg_app</item>
    </style>

    <style name="TextAppearance.MystMusic.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">?attr/mystOnSurface</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">0.98</item>
    </style>

    <style name="TextAppearance.MystMusic.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/mystOnSurface</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.MystMusic.Section" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/mystOnSurface</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.MystMusic.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/mystOnSurface</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <style name="TextAppearance.MystMusic.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/mystOnSurface</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextAppearance.MystMusic.Dim" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/mystOnSurfaceDim</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <style name="TextAppearance.MystMusic.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/mystOnSurfaceDim</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.MystMusic.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/mystAccentText</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.MystMusic.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/mystAccent</item>
        <item name="android:textColor">?attr/mystOnAccent</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">?attr/mystOnAccent</item>
        <item name="rippleColor">?attr/mystOnAccent</item>
    </style>

    <style name="Widget.MystMusic.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/mystAccentText</item>
        <item name="strokeColor">?attr/mystStrokeStrong</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">?attr/mystAccentText</item>
    </style>

    <style name="Widget.MystMusic.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/mystError</item>
        <item name="strokeColor">?attr/mystError</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">?attr/mystError</item>
    </style>

    <style name="Widget.MystMusic.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">?attr/mystAccentAlpha16</item>
        <item name="android:textColor">?attr/mystAccentText</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">?attr/mystAccentText</item>
    </style>

    <style name="Widget.MystMusic.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/mystOnSurface</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.MystMusic.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/mystSurface</item>
        <item name="cardCornerRadius">@dimen/corner_large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/mystStroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.MystMusic.Card.Glass" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/mystGlass</item>
        <item name="cardCornerRadius">@dimen/corner_xlarge</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/mystStroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.MystMusic.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipMinHeight">@dimen/touch_target</item>
        <item name="chipCornerRadius">@dimen/corner_pill</item>
    </style>

    <style name="Widget.MystMusic.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_text_input_stroke</item>
        <item name="boxBackgroundColor">?attr/mystGlass</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_pill</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_pill</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_pill</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_pill</item>
        <item name="hintTextColor">?attr/mystAccentText</item>
        <item name="android:textColorHint">?attr/mystOnSurfaceDim</item>
    </style>

    <style name="ShapeAppearance.MystMusic.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_large</item>
    </style>

    <style name="ShapeAppearance.MystMusic.CoverSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.MystMusic.CoverLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_xlarge</item>
    </style>

    <style name="ShapeAppearance.MystMusic.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
